# Copy to .env.local (gitignored) and fill in, then rebuild the app.
# Create these in Google Cloud Console: Google Auth Platform -> Clients -> Create client -> Desktop app.
LIFEPET_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
LIFEPET_GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# Optional: a Gemini API key from https://aistudio.google.com/apikey, used when none is saved in Settings.
# Only used in `npm run tauri dev`. Builds leave it out so they're safe to share; LIFEPET_SHARE_MY_KEYS=1 bakes it in.
LIFEPET_GEMINI_KEY=your-gemini-key

# Optional: an ElevenLabs key, built into the app only with LIFEPET_SHARE_MY_KEYS=1. It can be read back
# out of the app, so use a separate key restricted to text to speech and reading voices, with a credit limit.
LIFEPET_ELEVEN_KEY=your-elevenlabs-key
